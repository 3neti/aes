#!/usr/bin/env bash

set -euo pipefail

action="${1:-status}"
app_dir="/var/www/aes"
units=(
    waes-runtime.target
    waes-reverb.service
    waes-queue.service
    waes-scanner.service
    waes-scheduler.timer
)

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        printf 'Run waes-runtime %s as root.\n' "${action}" >&2
        exit 77
    fi
}

run_health_check() {
    cd "${app_dir}"

    if [[ "${EUID}" -eq 0 ]]; then
        runuser -u ace -- /usr/bin/php artisan election:runtime-check
    else
        /usr/bin/php artisan election:runtime-check
    fi
}

show_status() {
    systemctl --no-pager --full status "${units[@]}" || true
}

case "${action}" in
    start|stop|restart)
        require_root
        systemctl "${action}" waes-runtime.target
        show_status
        ;;
    status)
        show_status
        ;;
    check)
        run_health_check
        ;;
    logs)
        journalctl --no-pager -n "${WAES_LOG_LINES:-200}" \
            -u waes-reverb.service \
            -u waes-queue.service \
            -u waes-scanner.service \
            -u waes-scheduler.service \
            -u waes-scheduler.timer
        ;;
    *)
        printf 'Usage: waes-runtime {start|stop|restart|status|check|logs}\n' >&2
        exit 64
        ;;
esac
