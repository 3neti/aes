[Unit]
Description=Run WAES Laravel scheduled tasks
PartOf=waes-runtime.target
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=ace
Group=ace
WorkingDirectory=/var/www/aes
EnvironmentFile=-/etc/waes/runtime.env
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/aes/storage /var/www/aes/bootstrap/cache
