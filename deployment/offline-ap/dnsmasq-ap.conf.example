interface=wlp2s0
except-interface=enp1s0
except-interface=lo
listen-address=10.42.0.1
bind-dynamic
user=dnsmasq
no-hosts
domain-needed
bogus-priv
no-resolv
server=127.0.0.53
local=/waes.home.arpa/
address=/waes.home.arpa/10.42.0.1
local=/waes.consultel.ph/
address=/waes.consultel.ph/10.42.0.1
dhcp-authoritative
dhcp-range=10.42.0.50,10.42.0.200,255.255.255.0,12h
dhcp-option=option:router,10.42.0.1
dhcp-option=option:dns-server,10.42.0.1
dhcp-leasefile=/var/lib/waes-ap-leases/dnsmasq.leases

# Keep these dedicated probe domains in sync with config/hotspot.php.
local=/captive.apple.com/
address=/captive.apple.com/10.42.0.1
local=/connectivitycheck.gstatic.com/
address=/connectivitycheck.gstatic.com/10.42.0.1
local=/connectivitycheck.android.com/
address=/connectivitycheck.android.com/10.42.0.1
local=/www.msftconnecttest.com/
address=/www.msftconnecttest.com/10.42.0.1
local=/detectportal.firefox.com/
address=/detectportal.firefox.com/10.42.0.1
