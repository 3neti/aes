# Replace this path with the actual barcode scanner, never a general keyboard.
ELECTION_SCANNER_RUNTIME_MODE=evdev
ELECTION_SCANNER_DEVICE=/dev/input/by-id/usb-YOUR_SCANNER-event-kbd
ELECTION_SCANNER_INGESTION=precinct
ELECTION_SCANNER_STATION_ID=role-demo-precinct
ELECTION_SCANNER_HEARTBEAT_PATH=/var/www/aes/storage/app/private/runtime/heartbeats/scanner.json
ELECTION_SCANNER_HEARTBEAT_INTERVAL=30
ELECTION_SCANNER_RECONNECT_DELAY=2
