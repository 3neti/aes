# Merge into the existing application .env; do not replace APP_KEY or database credentials.
# Generate unique REVERB_APP_ID, REVERB_APP_KEY and REVERB_APP_SECRET separately.
APP_NAME="Alternative Election System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://10.42.0.1
DB_CONNECTION=mysql
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
MAIL_MAILER=log

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=10.42.0.1,waes.home.arpa,waes.local,waes.consultel.ph,localhost,127.0.0.1
# Add the current Ethernet address above if clients use its literal IP.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=waes.home.arpa
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
VITE_APP_NAME="${APP_NAME}"

ELECTION_PRINT_FORM_PROFILE=a4
ELECTION_PRINTER_ADAPTER=cups
ELECTION_PRINTER_DRIVER=cups
ELECTION_CUPS_PRINTER=HP_Laser_108a
ELECTION_CUPS_TIMEOUT=10
ELECTION_CONTROL_NUMBER_PRINTER_DRIVER=cups
ELECTION_CONTROL_NUMBER_CUPS_PRINTER=Thermal58
ELECTION_CONTROL_NUMBER_CUPS_TIMEOUT=10
ELECTION_CLOSEOUT_PRINTER_DRIVER=file
ELECTION_SCANNER_RUNTIME_MODE=evdev
ELECTION_SCANNER_DEVICE=/dev/input/by-id/usb-YOUR_SCANNER-event-kbd
ELECTION_SCANNER_INGESTION=precinct
ELECTION_SCANNER_STATION_ID=role-demo-precinct
ELECTION_CLOUD_EVIDENCE_ENABLED=false
