# Do not install unchanged. Derive and substitute the PSK only in a private local file.
# Never commit the real passphrase or derived PSK.
interface=wlp2s0
driver=nl80211
ssid=WAES
country_code=PH
ieee80211d=1
hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_psk=SET_LOCALLY_DO_NOT_COMMIT_REAL_KEYS
ignore_broadcast_ssid=0
ap_isolate=1
ctrl_interface=/run/hostapd
