APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

ELECTION_REVIEW_MODE=false
ELECTION_REVIEW_LABEL="COMELEC Review Environment"
ELECTION_REVIEW_CHAIRPERSON_CODE=SIM-OFFICER-001
ELECTION_REVIEW_POLL_CLERK_CODE=SIM-OFFICER-002
ELECTION_REVIEW_THIRD_MEMBER_CODE=SIM-OFFICER-003
ELECTION_REVIEW_OFFICER_PIN=123456
ELECTION_REVIEW_DEVICE_SERIAL=AES-PI-39010001-001
ELECTION_REVIEW_PRINTER_SERIAL=AES-PRINTER-39010001-001
ELECTION_REVIEW_SCANNER_SERIAL=AES-SCANNER-39010001-001
ELECTION_REVIEW_BALLOT_STOCK_START=1
ELECTION_REVIEW_BALLOT_STOCK_END=1000
ELECTION_REVIEW_BALLOT_BOX_ID=AES-BOX-39010001-001
ELECTION_REVIEW_CUSTODY_ENVELOPE_ID=AES-ENV-39010001-001
ELECTION_REVIEW_SEAL_NUMBERS=AES-SEAL-39010001-001,AES-SEAL-39010001-002

ELECTION_PRINTER_ADAPTER=simulated
ELECTION_PRINTER_DRIVER=file
ELECTION_CUPS_PRINTER=
ELECTION_CUPS_TIMEOUT=3
ELECTION_SCANNER_ADAPTER=simulated
ELECTION_SCANNER_DRIVER=manual
ELECTION_HANDHELD_SCANNER=
ELECTION_CAMERA_SCANNER=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
